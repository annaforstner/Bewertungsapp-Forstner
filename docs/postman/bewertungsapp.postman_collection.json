                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an(\"array\");",
                  "  pm.expect(json).to.have.lengthOf(2);",
                  "  const werte = Object.fromEntries(json.map(row => [row.criterionId, Number(row.durchschnitt)]));",
